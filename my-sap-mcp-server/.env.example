# Copy to .env and replace placeholders. Do not commit real credentials.
# Destination name SAP_ODATA in api-config.json maps to this prefix:
# uppercase, non-alphanumeric characters become underscores.

# SAP OData system host only (no entity-set path). Service path is pathPrefix in api-config.json.
SAP_ODATA_BASE_URL=https://your-sap-host.example.com

# OAuth2 client-credentials (required by odata-mcp-proxy for local/non-BTP runs)
SAP_ODATA_TOKEN_URL=https://your-auth-host.example.com/oauth/token
SAP_ODATA_CLIENT_ID=your-oauth-client-id
SAP_ODATA_CLIENT_SECRET=your-oauth-client-secret

# Transport: http (browser / MCP Inspector) or stdio (Claude Desktop)
MCP_TRANSPORT=http
PORT=4004
LOG_LEVEL=info
REQUEST_TIMEOUT=60000

# Optional. Defaults to api-config.json in this directory.
# API_CONFIG_FILE=api-config.json
