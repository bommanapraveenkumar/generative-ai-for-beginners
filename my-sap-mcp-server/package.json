    "mcp",
    "sap",
    "odata",
    "odata-mcp-proxy"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "odata-mcp-proxy": "^1.3.0"
  }
}
